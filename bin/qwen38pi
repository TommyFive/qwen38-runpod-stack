#!/usr/bin/env bash
# qwen38pi - Qwen3.8-27B abliterated, lean for a coding agent. SGLang API only, no OpenWebUI.
#
#   qwen38pi            starts the pod, waits until the API answers
#   qwen38pi 8h         longer window
#   qwen38pi status     what's running, what it costs
#   qwen38pi stop       terminate
#
# This is a thin wrapper around `qwen38fast`. The only difference from the full
# stack: OpenWebUI is never installed, so the pod is ready as soon as the API
# answers instead of also waiting on port 8080. Everything else (model, proxy,
# agent wiring) is identical.

# status and stop are template-independent and must be the first argument, so
# do NOT prepend --pi, otherwise the detection in qwen38fast won't trigger.
case "${1:-}" in
    status|stop) exec qwen38fast "$@" ;;
    *)           exec qwen38fast --pi "$@" ;;
esac
