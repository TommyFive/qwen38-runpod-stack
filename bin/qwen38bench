#!/usr/bin/env python3
"""Manual client-side RunPod proxy benchmark (NOT comparable to in-pod timings).

    qwen38bench [POD_ID] [--isl 8192] [--osl 1024] [--runs 3]
    qwen38bench --key-file ~/.runpod/qwen38.key
"""
import argparse
import json
import os
from pathlib import Path
import statistics
import subprocess
import sys
import time
import urllib.error
import urllib.request

PROMPT = (
    "Write a detailed technical explanation of how speculative decoding works "
    "in a transformer inference server, covering draft models, verification, "
    "and acceptance rates."
)


def running_pod():
    out = subprocess.run(["runpodctl", "pod", "list", "-o", "json"],
                         capture_output=True, text=True, check=True)
    pods = json.loads(out.stdout or "[]")
    if len(pods) != 1:
        sys.exit(f"{len(pods)} Pods am Laufen, Pod-ID bitte angeben")
    return pods[0]["id"]


def api_headers(key):
    h = {"Content-Type": "application/json",
         "User-Agent": "Mozilla/5.0 qwen38bench"}
    if key:
        h["Authorization"] = "Bearer " + key
    return h


def get(url, key="", timeout=30):
    return urllib.request.urlopen(
        urllib.request.Request(url, headers=api_headers(key)), timeout=timeout)


def post(url, payload, key="", timeout=600):
    return urllib.request.urlopen(
        urllib.request.Request(url, data=json.dumps(payload).encode(),
                               headers=api_headers(key)), timeout=timeout)


def events(response):
    parts = []
    for raw in response:
        line = raw.decode("utf-8").rstrip("\r\n")
        if line.startswith("data:"):
            parts.append(line[5:].lstrip(" "))
        elif not line and parts:
            yield "\n".join(parts)
            parts = []
    if parts:
        yield "\n".join(parts)


def one_run(api, model, isl, osl, key="", stream=True):
    prompt = PROMPT
    if isl > 0:
        # Rough padding, not an exact ISL measurement: use server usage.
        prompt = (PROMPT + " ") * max(1, isl // 25)
    payload = {
        "model": model,
        "messages": [{"role": "user", "content": prompt}],
        "max_tokens": osl,
        "temperature": 0.6,
        "top_p": 0.95,
        "stream": True,
        "stream_options": {"include_usage": True},
        "chat_template_kwargs": {"enable_thinking": False},
    }
    start = time.monotonic()
    ttft = None
    usage = None
    done = False
    with post(f"{api}/chat/completions", payload, key) as resp:
        for body in events(resp):
            if body == "[DONE]":
                done = True
                break
            chunk = json.loads(body)
            if isinstance(chunk.get("usage"), dict):
                usage = chunk["usage"]
            for choice in chunk.get("choices") or []:
                delta = choice.get("delta") or {}
                tool_output = any(
                    (call.get("function") or {}).get("arguments")
                    for call in delta.get("tool_calls") or []
                    if isinstance(call, dict))
                if ttft is None and (
                    delta.get("content") or delta.get("reasoning_content")
                    or tool_output):
                    ttft = time.monotonic() - start
    total = time.monotonic() - start
    if not done:
        raise ValueError("incomplete SSE stream")
    tokens = (usage or {}).get("completion_tokens")
    if not isinstance(tokens, int) or tokens < 0:
        tokens = None
    decode_time = total - ttft if ttft is not None else None
    tps = ((tokens - 1) / decode_time
           if tokens is not None and tokens > 1
           and decode_time is not None and decode_time > 0 else None)
    return {"ttft": ttft, "total": total, "out_tokens": tokens,
            "prompt_tokens": (usage or {}).get("prompt_tokens"), "tps": tps,
            "token_count_source": "server_usage" if tokens is not None else "unavailable"}


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("pod_id", nargs="?")
    ap.add_argument("--isl", type=int, default=8192)
    ap.add_argument("--osl", type=int, default=1024)
    ap.add_argument("--runs", type=int, default=3)
    ap.add_argument("--key-file", default=os.environ.get(
        "QWEN38_API_KEY_FILE", str(Path.home() / ".runpod/qwen38.key")))
    args = ap.parse_args()
    if args.runs < 1 or args.osl < 1 or args.isl < 0:
        ap.error("--runs/--osl must be positive, --isl must be nonnegative")

    key_path = Path(args.key_file).expanduser()
    key = key_path.read_text().strip() if key_path.is_file() else ""
    pod = args.pod_id or running_pod()
    api = f"https://{pod}-8000.proxy.runpod.net/v1"
    try:
        with get(f"{api}/models", key) as r:
            model = json.load(r)["data"][0]["id"]
        print(f"Pod {pod} | model {model} | proxy path (NOT in-pod timings)")
        print(f"Approx. ISL {args.isl} / OSL {args.osl}, concurrency 1")
        print("Warmup (discarded)...", flush=True)
        one_run(api, model, args.isl, args.osl, key)
        results = []
        for i in range(args.runs):
            r = one_run(api, model, args.isl, args.osl, key)
            results.append(r)
            speed = f"{r['tps']:.1f}" if r["tps"] is not None else "n/a"
            ttft = f"{r['ttft'] * 1000:.0f}" if r["ttft"] is not None else "n/a"
            print(f"  run {i + 1}: {speed} tok/s | TTFT {ttft} ms | "
                  f"{r['out_tokens']} server tokens")
    except urllib.error.HTTPError as exc:
        if exc.code in (401, 403):
            print("API authorization failed; check --key-file "
                  "(SGLang Bearer token)", file=sys.stderr)
        else:
            print(f"API returned HTTP {exc.code}", file=sys.stderr)
        return 1

    speed = [r["tps"] for r in results if r["tps"] is not None]
    latency = [r["ttft"] for r in results if r["ttft"] is not None]
    print(f"\nMedian decode: {statistics.median(speed):.1f} tok/s"
          if speed else "\nDecode: n/a (server usage unavailable)")
    if latency:
        print(f"Median TTFT: {statistics.median(latency) * 1000:.0f} ms")
    print("Missing completion_tokens => no token-rate estimate; "
          "SSE chunk count is never substituted.")
    print("GPU/engine/context/model details: compare separately with the "
          "in-pod JSON report; remote and local latencies are not equivalent.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
