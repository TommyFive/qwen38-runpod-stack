#!/usr/bin/env python3
"""qwen38bench - measure what the running pod actually decodes at.

    qwen38bench                 # picks the only running pod
    qwen38bench <POD_ID>
    qwen38bench --isl 8192      # match the cookbook's ISL 8192 / OSL 1024 point

Reports TTFT, output tok/s per request, and the server's accepted-token length
under speculative decoding. A number without warmup is 2 to 10 times too low,
so the first run is always discarded.

Every figure printed here is single-stream (concurrency 1). That is the number
that matters for a chat session; it is NOT the same as aggregate throughput.
"""
import argparse
import json
import subprocess
import sys
import time
import urllib.error
import urllib.request

PROMPT = (
    "Write a detailed technical explanation of how speculative decoding works "
    "in a transformer inference server, covering draft models, verification, "
    "and acceptance rates."
)


def running_pod() -> str:
    out = subprocess.run(
        ["runpodctl", "pod", "list", "-o", "json"],
        capture_output=True, text=True, check=False,
    )
    pods = json.loads(out.stdout or "[]")
    if len(pods) != 1:
        sys.exit(f"{len(pods)} Pods am Laufen, Pod-ID bitte angeben")
    return pods[0]["id"]


# RunPod's proxy answers 403 to the default Python-urllib user agent.
HEADERS = {
    "Content-Type": "application/json",
    "User-Agent": "Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7) qwen38bench",
}


def get(url: str, timeout: int = 30):
    req = urllib.request.Request(url, headers=HEADERS)
    return urllib.request.urlopen(req, timeout=timeout)


def post(url: str, payload: dict, timeout: int = 600):
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode(),
        headers=HEADERS,
    )
    return urllib.request.urlopen(req, timeout=timeout)


def one_run(api: str, model: str, isl: int, osl: int, stream: bool = True) -> dict:
    prompt = PROMPT
    if isl > 0:
        # Pad to roughly the requested input length. Tokens are ~4 chars.
        prompt = (PROMPT + " ") * max(1, isl // 25)
    payload = {
        "model": model,
        "messages": [{"role": "user", "content": prompt}],
        "max_tokens": osl,
        "temperature": 0.6,
        "top_p": 0.95,
        "stream": stream,
        "stream_options": {"include_usage": True} if stream else None,
        # Thinking on by default would spend the whole budget in the reasoning
        # trace and make the number meaningless for a chat turn.
        "chat_template_kwargs": {"enable_thinking": False},
    }
    payload = {k: v for k, v in payload.items() if v is not None}

    start = time.perf_counter()
    ttft = None
    tokens = 0
    usage = None
    with post(f"{api}/chat/completions", payload) as resp:
        for raw in resp:
            line = raw.decode().strip()
            if not line.startswith("data: "):
                continue
            body = line[6:]
            if body == "[DONE]":
                break
            chunk = json.loads(body)
            if chunk.get("usage"):
                usage = chunk["usage"]
            for ch in chunk.get("choices", []):
                if ch.get("delta", {}).get("content"):
                    if ttft is None:
                        ttft = time.perf_counter() - start
                    tokens += 1
    total = time.perf_counter() - start
    out_tokens = (usage or {}).get("completion_tokens") or tokens
    decode_time = total - (ttft or 0)
    return {
        "ttft": ttft or 0.0,
        "total": total,
        "out_tokens": out_tokens,
        "tps": out_tokens / decode_time if decode_time > 0 else 0.0,
    }


def server_info(api: str) -> dict:
    try:
        base = api.rsplit("/v1", 1)[0]
        with get(f"{base}/get_server_info", timeout=15) as r:
            return json.loads(r.read())
    except Exception:
        return {}


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("pod_id", nargs="?")
    ap.add_argument("--isl", type=int, default=8192, help="input length in tokens")
    ap.add_argument("--osl", type=int, default=1024, help="output length in tokens")
    ap.add_argument("--runs", type=int, default=3, help="measured runs after warmup")
    args = ap.parse_args()

    pod = args.pod_id or running_pod()
    api = f"https://{pod}-8000.proxy.runpod.net/v1"

    with get(f"{api}/models") as r:
        model = json.loads(r.read())["data"][0]["id"]
    print(f"Pod {pod} | Modell {model}")
    print(f"ISL {args.isl} / OSL {args.osl}, Nebenläufigkeit 1\n")

    print("Warmlauf (wird verworfen)...", flush=True)
    one_run(api, model, args.isl, args.osl)

    results = []
    for i in range(args.runs):
        r = one_run(api, model, args.isl, args.osl)
        results.append(r)
        print(f"  Lauf {i+1}: {r['tps']:6.1f} tok/s | TTFT {r['ttft']*1000:7.0f} ms "
              f"| {r['out_tokens']} Tokens")

    tps = sorted(x["tps"] for x in results)
    ttft = sorted(x["ttft"] for x in results)
    mid = len(tps) // 2
    print(f"\n  Median: {tps[mid]:.1f} tok/s | TTFT {ttft[mid]*1000:.0f} ms "
          f"| TPOT {1000/tps[mid]:.2f} ms")

    info = server_info(api)
    for key in ("speculative_algorithm", "avg_spec_accept_length",
                "accept_length", "max_running_requests"):
        if key in info:
            print(f"  {key}: {info[key]}")

    print("\nOhne Hardware, Engine-Version, Quantisierung und Kontextlänge "
          "ist jede dieser Zahlen wertlos. Alle vier gehören ins Protokoll.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
